  "editorSample": "/* 中英文混排 · 实时 Token */\n:root {\n  --ts-color-primary: var(--ts-color-primary);\n  --ts-color-text: var(--ts-color-text);\n  --ts-glass-blur: var(--ts-glass-blur);\n  --ts-radius-lg: var(--ts-radius-lg);\n}\n\n.panel {\n  background: var(--ts-glass-surface);\n  color: var(--ts-color-text-primary);\n  border: var(--ts-border-width) solid var(--ts-color-border);\n}\n\n.button {\n  background: var(--ts-color-primary);\n}",
  "editorJson": "{\n  \"id\": \"atlas-sample\",\n  \"name\": \"Atlas Sample\",\n  \"colors\": {\n    \"primary\": \"var(--ts-color-primary)\",\n    \"text\": \"var(--ts-color-text)\",\n    \"border\": \"var(--ts-color-border)\"\n  },\n  \"glass\": {\n    \"opacity\": 0.92,\n    \"blur\": 4\n  }\n}",
  "editorComponents": "/* 组件类使用同一套 Token */\n.tg-panel {\n  background: var(--ts-glass-surface);\n  color: var(--ts-color-text-primary);\n}\n\n.tg-button {\n  background: var(--ts-color-primary);\n  color: var(--ts-color-on-primary);\n}\n\n.tg-input:focus {\n  border-color: var(--ts-color-focus-border);\n}",
  "editorVariables": ":root {\n  --ts-color-border: var(--ts-color-border);\n  --ts-shadow-outer: var(--ts-shadow-outer);\n  --ts-font-family: var(--ts-font-family);\n}",
  "editorTailwind": "@theme {\n  --color-primary: var(--ts-color-primary);\n  --color-surface: var(--ts-color-elevated-surface);\n}\n\n.glass-panel {\n  background: var(--ts-glass-surface);\n}",
  "editorReadme": "# Atlas 样例\n\n主题包包含 JSON、CSS、Tailwind 和 shadcn。\n文字使用前景 Token，面板使用表面色。",
  "terminalBody": "PS Atlas> theme apply\napplied tokens in 3 ms\nPS Atlas> theme contrast\n正文 7.2:1  辅助 4.6:1\n终端文字保持清晰，不使用玻璃模糊。\nTerminal text stays sharp. No glass blur.\nPS Atlas> theme export css\nready",
