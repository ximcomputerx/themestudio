{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron/preload/**/*.d.ts"
  ],
  "exclude": ["src/shared/path-guard.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engine/*": ["src/theme-engine/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["vite/client"]
  }
}
