{
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "electron/**/*.ts",
    "src/theme-engine/**/*.ts",
    "src/shared/**/*.ts",
    "src/store/history.ts",
    "src/i18n/resources.ts",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/theme-engine/*"],
      "@shared/*": ["src/shared/*"],
      "@i18n/*": ["src/i18n/*"]
    }
  }
}
